# Contact form delivery (app/contact/actions.ts).
# Copy to .env.local and fill in. Never commit the real key.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified in Resend.
# Until oakridgemanorliving.com is verified you can use Resend's test sender,
# which only delivers to the address that owns the Resend account:
#   CONTACT_FROM="Oakridge Manor Living <onboarding@resend.dev>"
CONTACT_FROM="Oakridge Manor Living <website@oakridgemanorliving.com>"
